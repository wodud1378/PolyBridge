<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="sandbox-window">
        <ui:VisualElement name="config-section" class="sandbox-window__section">
            <ui:Label text="Configuration" class="sandbox-window__section-title" />

            <ui:VisualElement name="config-missing" class="sandbox-window__config-missing">
                <ui:Label text="SandboxConfig not found." class="sandbox-window__message" />
                <ui:Button name="btn-create-config" text="Create Config" class="sandbox-window__btn" />
            </ui:VisualElement>

            <ui:VisualElement name="config-found" class="sandbox-window__config-found">
                <ui:Label name="config-path" class="sandbox-window__config-path" />
                <ui:Button name="btn-select-config" text="Select" class="sandbox-window__btn--small" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-section" class="sandbox-window__section">
            <ui:Label text="Settings" class="sandbox-window__section-title" />
            <ui:IMGUIContainer name="config-inspector" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
