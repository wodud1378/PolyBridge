.sandbox-root {
    flex-grow: 1;
    background-color: rgb(30, 30, 30);
}

/* Tab Bar */
.sandbox-tab-bar {
    flex-direction: row;
    background-color: rgb(40, 40, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
    flex-shrink: 0;
}

.sandbox-tab {
    padding: 8px 16px;
    color: rgb(140, 140, 140);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-font-style: normal;
    font-size: 13px;
}

.sandbox-tab:hover {
    color: rgb(200, 200, 200);
    background-color: rgb(50, 50, 50);
}

.sandbox-tab--active {
    color: rgb(255, 255, 255);
    border-bottom-color: rgb(80, 170, 255);
    -unity-font-style: bold;
}

/* Content */
.sandbox-scroll {
    flex-grow: 1;
    padding: 8px;
}

/* Method Card */
.sandbox-method-card {
    background-color: rgb(45, 45, 45);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    padding: 10px;
    margin-bottom: 8px;
}

.sandbox-method-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.sandbox-method-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
}

.sandbox-method-badge {
    font-size: 10px;
    color: rgb(120, 180, 255);
    background-color: rgb(35, 55, 80);
    border-radius: 3px;
    padding: 1px 6px;
}

/* Params */
.sandbox-params {
    margin-bottom: 6px;
    padding-left: 8px;
}

.sandbox-param-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.sandbox-param-label {
    width: 100px;
    color: rgb(160, 160, 160);
    font-size: 11px;
}

.sandbox-param-type {
    width: 60px;
    color: rgb(100, 140, 100);
    font-size: 10px;
    -unity-font-style: italic;
}

.sandbox-param-input {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    color: rgb(200, 200, 200);
    border-color: rgb(70, 70, 70);
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 12px;
}

/* Buttons */
.sandbox-btn-row {
    flex-direction: row;
    margin-top: 4px;
}

.sandbox-invoke-btn {
    flex-grow: 1;
    padding: 5px 12px;
    background-color: rgb(50, 110, 190);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.sandbox-invoke-btn:hover {
    background-color: rgb(70, 130, 210);
}

.sandbox-invoke-btn:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

.sandbox-clear-btn {
    width: 60px;
    margin-left: 4px;
    padding: 5px 8px;
    background-color: rgb(60, 60, 60);
    color: rgb(180, 180, 180);
    border-radius: 4px;
    border-width: 0;
    font-size: 11px;
}

.sandbox-clear-btn:hover {
    background-color: rgb(75, 75, 75);
}

/* Result */
.sandbox-result {
    margin-top: 6px;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: rgb(25, 25, 25);
    border-width: 1px;
    border-left-width: 3px;
}

.sandbox-result--success {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 180, 80);
}

.sandbox-result--error {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(220, 80, 80);
}

.sandbox-result--running {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(200, 180, 60);
}

.sandbox-result-status {
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.sandbox-result-status--success {
    color: rgb(80, 180, 80);
}

.sandbox-result-status--error {
    color: rgb(220, 80, 80);
}

.sandbox-result-status--running {
    color: rgb(200, 180, 60);
}

.sandbox-result-body {
    font-size: 11px;
    color: rgb(180, 180, 180);
    white-space: normal;
    min-height: 14px;
}
