.sandbox-scroll {
    flex-grow: 1;
    padding: 10px;
}

.sandbox-method-card {
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    padding: 14px;
    margin-bottom: 10px;
}

.sandbox-method-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.sandbox-method-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
}

.sandbox-method-badge {
    font-size: 12px;
    color: rgb(120, 180, 255);
    background-color: rgb(35, 55, 80);
    border-radius: 4px;
    padding: 2px 8px;
}

.sandbox-params {
    margin-bottom: 8px;
    padding-left: 10px;
}

.sandbox-param-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.sandbox-param-label {
    width: 110px;
    color: rgb(160, 160, 160);
    font-size: 14px;
}

.sandbox-param-type {
    width: 70px;
    color: rgb(100, 140, 100);
    font-size: 12px;
    -unity-font-style: italic;
}

.sandbox-param-input {
    flex-grow: 1;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: rgb(20, 20, 20);
}

.sandbox-param-input .unity-base-text-field__input {
    color: rgb(20, 20, 20);
}

.sandbox-param-input .unity-text-element {
    color: rgb(20, 20, 20);
}

.sandbox-btn-row {
    flex-direction: row;
    margin-top: 6px;
}

.sandbox-invoke-btn {
    flex-grow: 1;
    padding: 10px 16px;
    background-color: rgb(50, 110, 190);
    color: rgb(255, 255, 255);
    border-radius: 6px;
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.sandbox-invoke-btn:hover {
    background-color: rgb(70, 130, 210);
}

.sandbox-invoke-btn:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

.sandbox-clear-btn {
    width: 70px;
    margin-left: 6px;
    padding: 10px 10px;
    background-color: rgb(60, 60, 60);
    color: rgb(180, 180, 180);
    border-radius: 6px;
    border-width: 0;
    font-size: 14px;
}

.sandbox-clear-btn:hover {
    background-color: rgb(75, 75, 75);
}

.sandbox-result {
    margin-top: 8px;
    border-radius: 6px;
    padding: 10px 12px;
    background-color: rgb(25, 25, 25);
    border-width: 1px;
    border-left-width: 4px;
}

.sandbox-result--success {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 180, 80);
}

.sandbox-result--error {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(220, 80, 80);
}

.sandbox-result--running {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(200, 180, 60);
}

.sandbox-result-status {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.sandbox-result-status--success { color: rgb(80, 180, 80); }
.sandbox-result-status--error { color: rgb(220, 80, 80); }
.sandbox-result-status--running { color: rgb(200, 180, 60); }

.sandbox-result-body {
    font-size: 14px;
    color: rgb(180, 180, 180);
    white-space: normal;
    min-height: 18px;
}

/* Event Card */
.sandbox-event-card {
    background-color: rgb(42, 48, 42);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(55, 70, 55);
    padding: 12px;
    margin-bottom: 10px;
}

.sandbox-event-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.sandbox-event-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(140, 220, 140);
}

.sandbox-event-badge {
    font-size: 12px;
    color: rgb(100, 180, 100);
    background-color: rgb(35, 55, 35);
    border-radius: 4px;
    padding: 2px 8px;
}

.sandbox-event-log {
    max-height: 150px;
}

.sandbox-event-entry {
    flex-direction: row;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 50, 40);
}

.sandbox-event-time {
    width: 70px;
    font-size: 13px;
    color: rgb(90, 120, 90);
}

.sandbox-event-data {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(180, 220, 180);
    white-space: normal;
}
