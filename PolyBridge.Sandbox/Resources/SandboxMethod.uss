.sandbox-scroll {
    flex-grow: 1;
    padding: 8px;
}

.sandbox-method-card {
    background-color: rgb(45, 45, 45);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    padding: 10px;
    margin-bottom: 8px;
}

.sandbox-method-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.sandbox-method-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
}

.sandbox-method-badge {
    font-size: 10px;
    color: rgb(120, 180, 255);
    background-color: rgb(35, 55, 80);
    border-radius: 3px;
    padding: 1px 6px;
}

.sandbox-params {
    margin-bottom: 6px;
    padding-left: 8px;
}

.sandbox-param-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.sandbox-param-label {
    width: 100px;
    color: rgb(160, 160, 160);
    font-size: 11px;
}

.sandbox-param-type {
    width: 60px;
    color: rgb(100, 140, 100);
    font-size: 10px;
    -unity-font-style: italic;
}

.sandbox-param-input {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    color: rgb(200, 200, 200);
    border-color: rgb(70, 70, 70);
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 12px;
}

.sandbox-btn-row {
    flex-direction: row;
    margin-top: 4px;
}

.sandbox-invoke-btn {
    flex-grow: 1;
    padding: 5px 12px;
    background-color: rgb(50, 110, 190);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.sandbox-invoke-btn:hover {
    background-color: rgb(70, 130, 210);
}

.sandbox-invoke-btn:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

.sandbox-clear-btn {
    width: 60px;
    margin-left: 4px;
    padding: 5px 8px;
    background-color: rgb(60, 60, 60);
    color: rgb(180, 180, 180);
    border-radius: 4px;
    border-width: 0;
    font-size: 11px;
}

.sandbox-clear-btn:hover {
    background-color: rgb(75, 75, 75);
}

.sandbox-result {
    margin-top: 6px;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: rgb(25, 25, 25);
    border-width: 1px;
    border-left-width: 3px;
}

.sandbox-result--success {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(80, 180, 80);
}

.sandbox-result--error {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(220, 80, 80);
}

.sandbox-result--running {
    border-color: rgb(60, 60, 60);
    border-left-color: rgb(200, 180, 60);
}

.sandbox-result-status {
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.sandbox-result-status--success { color: rgb(80, 180, 80); }
.sandbox-result-status--error { color: rgb(220, 80, 80); }
.sandbox-result-status--running { color: rgb(200, 180, 60); }

.sandbox-result-body {
    font-size: 11px;
    color: rgb(180, 180, 180);
    white-space: normal;
    min-height: 14px;
}

/* Sub Tabs */
.sandbox-sub-tab-bar {
    flex-direction: row;
    background-color: rgb(38, 38, 38);
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 55, 55);
}

.sandbox-sub-tab {
    padding: 4px 12px;
    font-size: 11px;
    color: rgb(120, 120, 120);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.sandbox-sub-tab:hover {
    color: rgb(200, 200, 200);
}

.sandbox-sub-tab--active {
    color: rgb(255, 255, 255);
    border-bottom-color: rgb(100, 180, 100);
}

/* Event Card */
.sandbox-event-card {
    background-color: rgb(42, 48, 42);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(55, 70, 55);
    padding: 8px;
    margin-bottom: 8px;
}

.sandbox-event-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.sandbox-event-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(140, 220, 140);
}

.sandbox-event-badge {
    font-size: 10px;
    color: rgb(100, 180, 100);
    background-color: rgb(35, 55, 35);
    border-radius: 3px;
    padding: 1px 6px;
}

.sandbox-event-log {
    max-height: 120px;
}

.sandbox-event-entry {
    flex-direction: row;
    padding: 1px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 50, 40);
}

.sandbox-event-time {
    width: 60px;
    font-size: 10px;
    color: rgb(90, 120, 90);
}

.sandbox-event-data {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(180, 220, 180);
    white-space: normal;
}
